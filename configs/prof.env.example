# ---- PROF production env (copy to configs/prof.env, never commit secrets) ----
# Demo mode MUST be 0 in production: gateway refuses to start without a key.
PROF_DEMO=0
# Approver subject + base64 Ed25519 private key (generate: python -c "from prof.identity import Approver; a=Approver.generate('user:alice'); print(a.export_private_b64())")
PROF_SUBJECT=user:approver
PROF_APPROVER_PRIV=CHANGE_ME
# Durable stores (compose maps /data to a named volume)
PROF_LEDGER=/data/ledger.json
PROF_NONCES=/data/nonces.json
# SQLite resource DB (customers, accounts, payments, file registry) — persistent
PROF_DB=/data/prof.db
# Require explicit human step for high-tier approvals at the API layer (defense in depth)
PROF_REQUIRE_HUMAN=0
# Bearer token for state-changing + approval-queue endpoints (console prompts for it)
PROF_API_TOKEN=CHANGE_ME_TOO
# Per-IP rate limit on hot mutating paths (requests/minute, 0 disables)
PROF_RATE_LIMIT=300
PORT=8091
